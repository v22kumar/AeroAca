    {
      "id": "c-memory",
      "dir": "labs/c/memory",
      "language": "c",
      "file": "memory.c",
      "command": "gcc -std=c11 -Wall -Wextra -o memory memory.c && ./memory"
    },
    {
      "id": "c-debounce",
      "dir": "labs/c/debounce",
      "language": "c",
      "file": "debounce.c",
      "command": "gcc -std=c11 -Wall -Wextra -o debounce debounce.c && ./debounce"
    },
    {
      "id": "c-ring",
      "dir": "labs/c/ring",
      "language": "c",
